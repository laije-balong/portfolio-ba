<p style="margin: 0; font-size: 13px; color: #5B6160">32 user stories, priorisées en MoSCoW</p>
<div role="img" aria-label="19 Must, 7 Should, 5 Could, 1 socle" style="display: flex; gap: 4px; height: 14px; margin-top: 12px">
<span style="flex: 19; border-radius: 4px; background: #3F6B57"></span>
<span style="flex: 7; border-radius: 4px; background: #8FAE9C"></span>
<span style="flex: 5; border-radius: 4px; background: #C9D7CE"></span>
<span style="flex: 1; border-radius: 4px; background: #17191A"></span>
</div>
<p style="margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 14px"><span><strong style="font-weight: 600">19</strong> Must</span><span><strong style="font-weight: 600">7</strong> Should</span><span><strong style="font-weight: 600">5</strong> Could</span><span><strong style="font-weight: 600">1</strong> socle</span></p>
</div>
<div style="padding: 20px; border-radius: 12px; background: #FFFFFF; border: 1px solid #D5DCD7">
<p style="margin: 0; font-size: 13px; color: #5B6160">Recette</p>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 10px">
<div><p style="margin: 0; font-weight: 600; font-size: 28px; letter-spacing: -0.02em">34</p><p style="margin: 0; font-size: 13px; color: #5B6160">cas de test</p></div>
<div><p style="margin: 0; font-weight: 600; font-size: 28px; letter-spacing: -0.02em">6</p><p style="margin: 0; font-size: 13px; color: #5B6160">anomalies</p></div>
<div><p style="margin: 0; font-weight: 600; font-size: 28px; letter-spacing: -0.02em">2</p><p style="margin: 0; font-size: 13px; color: #5B6160">bloquantes</p></div>
</div>
