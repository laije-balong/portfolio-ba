.legend { flex: 1 1 220px; min-width: 0; font-size: 15px; }
.legend__title { margin: 0; font-weight: 600; }
.legend__list { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; color: var(--color-text-muted); }
.legend__item { display: flex; align-items: center; gap: 12px; }
.legend__swatch { flex: none; }
.legend__swatch--start { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--color-accent); box-sizing: border-box; }
.legend__swatch--end { width: 18px; height: 18px; border-radius: 50%; border: 4px solid var(--color-ink); box-sizing: border-box; }
