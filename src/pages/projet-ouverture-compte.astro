  padding: 32px;
  border-radius: var(--radius-card);
  background: var(--color-surface-muted);
  display: flex;
  flex-wrap: wrap;
  gap: 32px;
  align-items: flex-start;
}
.schema-fig__canvas { flex: 999 1 560px; min-width: 0; overflow-x: auto; }
