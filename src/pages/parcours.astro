---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cert from '../components/Cert.astro';
---
<BaseLayout
  title="Parcours, Laije Belthassar BALONG"
  description="Expériences, formations et certifications de Laije Belthassar BALONG, Business Analyst à Brazzaville, de la plus récente à la plus ancienne."
  active="parcours"
  current={true}
>

<p class="back"><a href="/" class="btn btn--line btn--xs"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3F6B57" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6l-6 6 6 6"></path></svg>Retour à l'accueil</a></p>

<section class="parcours-head">
<h1 class="page-title">Parcours</h1>
<p class="parcours-lead">Expériences, formations et certifications, de la plus récente à la plus ancienne.</p>
</section>

<div class="timeline-cols">

<div class="tl-card">
<h2 class="tl-card__title">Expérience</h2>
<ol class="timeline">
<li class="timeline__item">
<span class="timeline__dot" aria-hidden="true"></span>
<p class="timeline__date">Depuis août 2026</p>
<div class="timeline__body">
<p class="timeline__role">Brand Ambassadeur</p>
<p class="timeline__org">MTN Skills Academy, Fondation MTN Congo</p>
<p class="timeline__detail">Plus de 25 personnes accompagnées, jusqu'à plus de 600 certificats.</p>
</div>
</li>
<li class="timeline__item timeline__item--last">
<span class="timeline__dot timeline__dot--open" aria-hidden="true"></span>
<p class="timeline__date timeline__date--muted">Mai à juin 2026</p>
<div class="timeline__body">
<p class="timeline__role">Analyste testeur</p>
<p class="timeline__org">African Global Multiservice Consulting</p>
<p class="timeline__detail">Audit d'un site web, scénarios de test, suivi des anomalies.</p>
</div>
</li>
</ol>
</div>

<div class="tl-card tl-card--muted">
<h2 class="tl-card__title">Formation</h2>
<ol class="timeline timeline--muted">
<li class="timeline__item">
<span class="timeline__dot" aria-hidden="true"></span>
<p class="timeline__date">En cours</p>
<div class="timeline__body">
<p class="timeline__role">IBM System Analyst</p>
<p class="timeline__org">Formation professionnelle certifiante</p>
<p class="timeline__detail">Dont le TP du tableau de bord ventes et SAV.</p>
</div>
</li>
<li class="timeline__item">
<span class="timeline__dot" aria-hidden="true"></span>
<p class="timeline__date">Depuis juin 2026</p>
<div class="timeline__body">
<p class="timeline__role">Business Analyst</p>
<p class="timeline__org">Akieni Academy</p>
<p class="timeline__detail">Formation professionnelle en analyse métier, études de cas en équipe.</p>
</div>
</li>
<li class="timeline__item timeline__item--last">
<span class="timeline__dot" aria-hidden="true"></span>
<p class="timeline__date">2025 à 2026</p>
<div class="timeline__body">
<p class="timeline__role">Licence Réseaux et Télécommunications (en cours)</p>
<p class="timeline__org">IPH, Brazzaville</p>
</div>
</li>
</ol>
</div>

</div>

<section class="certs">
<div class="certs-head">
<h2 class="section-title">Certifications</h2>
<a href="https://www.credly.com/users/laije-belthassar" class="lnk certs-credly">Vérifier sur Credly</a>
</div>
<div class="cert-grid">
<Cert title="Business Analyst" issuer="Microsoft" logo="microsoft.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="Data Analytics" issuer="Google" logo="google.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="Business Intelligence" issuer="Google" logo="google.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="Python Development" issuer="Microsoft" logo="microsoft.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="English for IT 1 et 2" issuer="OpenEDG" logo="openedg.svg" note="2026" />
<Cert title="System Analyst" issuer="IBM" logo="ibm.svg" platform="Coursera" platformLogo="coursera.svg" note="En cours" muted={true} />
</div>
</section>

<section class="langs">
<h2 class="section-title langs__title">Langues</h2>
<ul class="langs__list">
<li class="lang">Français</li>
<li class="lang">Lingala</li>
<li class="lang">Kituba</li>
<li class="lang">Anglais technique</li>
</ul>
</section>

</BaseLayout>

<style>
.back { margin: 40px 0 0; }
.parcours-head { padding: 40px 0 48px; }
.parcours-lead { margin: 20px 0 0; max-width: 60ch; font-size: 19px; color: var(--color-text-muted); }

.timeline-cols { display: flex; flex-wrap: wrap; gap: 20px; padding-bottom: var(--space-section); }
.tl-card {
  flex: 1 1 420px;
  min-width: 0;
  padding: 32px;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
}
.tl-card--muted { background: var(--color-surface-muted); border: 0; }
.tl-card__title { margin: 0 0 24px; font-weight: 600; font-size: 22px; }

.timeline { list-style: none; margin: 0; padding: 0; }
.timeline__item {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 4px 24px;
  padding: 0 0 28px 28px;
  border-left: 2px solid var(--color-border);
  margin-left: 5px;
}
.timeline--muted .timeline__item { border-left-color: #D5DCD7; }
.timeline__item--last { border-left-color: transparent; padding-bottom: 4px; }
.timeline__dot {
  position: absolute;
  left: -7px;
  top: 5px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--color-accent);
}
.timeline__dot--open { background: var(--color-surface); border: 2px solid #B9C6BE; box-sizing: border-box; }
.timeline__date { flex: 0 0 130px; margin: 0; font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
.timeline__date--muted { color: var(--color-text-subtle); }
.timeline__body { flex: 1 1 220px; min-width: 0; }
.timeline__role { margin: 0; font-weight: 600; }
.timeline__org { margin: 0; font-size: 15px; color: var(--color-text-subtle); }
.timeline__detail { margin: 8px 0 0; font-size: 15px; }

.certs { padding-bottom: var(--space-section); }
.certs-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  margin-bottom: 32px;
}
.certs-credly { font-size: 15px; }
.cert-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }

.langs { display: flex; flex-wrap: wrap; gap: 24px 64px; padding-bottom: var(--space-section-lg); }
.langs__title { flex: 1 1 240px; }
.langs__list { flex: 999 1 520px; min-width: 0; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
.lang { padding: 10px 18px; border-radius: var(--radius-pill); background: var(--color-surface); border: 1px solid var(--color-border); }
</style>
