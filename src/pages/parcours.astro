---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cert from '../components/Cert.astro';
---
<BaseLayout
  title="Parcours, Laije Belthassar BALONG"
  description="Expériences, formations et certifications de Laije Belthassar BALONG, Business Analyst à Brazzaville, de la plus récente à la plus ancienne."
  active="parcours"
  current={true}
>

<p style="margin: 40px 0 0"><a href="/" class="btn btn-line" style="display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border: 1px solid #D5D9D4; border-radius: 999px; text-decoration: none; color: #17191A; font-size: 14px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3F6B57" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6l-6 6 6 6"></path></svg>Retour à l'accueil</a></p>

<section style="padding: 40px 0 48px">
<h1 style="margin: 0; font-weight: 600; font-size: 56px; line-height: 1.06; letter-spacing: -0.03em">Parcours</h1>
<p style="margin: 20px 0 0; max-width: 60ch; font-size: 19px; color: #4A504E">Expériences, formations et certifications, de la plus récente à la plus ancienne.</p>
</section>

<div style="display: flex; flex-wrap: wrap; gap: 20px; padding-bottom: 88px">

<div style="flex: 1 1 420px; min-width: 0; padding: 32px; border-radius: 24px; background: #FFFFFF; border: 1px solid #E3E5E1">
<h2 style="margin: 0 0 24px; font-weight: 600; font-size: 22px">Expérience</h2>
<ol style="list-style: none; margin: 0; padding: 0">
<li style="position: relative; display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 0 0 28px 28px; border-left: 2px solid #E3E5E1; margin-left: 5px">
<span aria-hidden="true" style="position: absolute; left: -7px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: #3F6B57"></span>
<p style="flex: 0 0 130px; margin: 0; font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #3F6B57">Depuis août 2026</p>
<div style="flex: 1 1 220px; min-width: 0">
<p style="margin: 0; font-weight: 600">Brand Ambassadeur</p>
<p style="margin: 0; font-size: 15px; color: #5B6160">MTN Skills Academy, Fondation MTN Congo</p>
<p style="margin: 8px 0 0; font-size: 15px">Plus de 25 personnes accompagnées, jusqu'à plus de 600 certificats.</p>
</div>
</li>
<li style="position: relative; display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 0 0 4px 28px; border-left: 2px solid transparent; margin-left: 5px">
<span aria-hidden="true" style="position: absolute; left: -7px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: #FFFFFF; border: 2px solid #B9C6BE; box-sizing: border-box"></span>
<p style="flex: 0 0 130px; margin: 0; font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #5B6160">Mai à juin 2026</p>
<div style="flex: 1 1 220px; min-width: 0">
<p style="margin: 0; font-weight: 600">Analyste testeur</p>
<p style="margin: 0; font-size: 15px; color: #5B6160">African Global Multiservice Consulting</p>
<p style="margin: 8px 0 0; font-size: 15px">Audit d'un site web, scénarios de test, suivi des anomalies.</p>
</div>
</li>
</ol>
</div>

<div style="flex: 1 1 420px; min-width: 0; padding: 32px; border-radius: 24px; background: #F1F4F2">
<h2 style="margin: 0 0 24px; font-weight: 600; font-size: 22px">Formation</h2>
<ol style="list-style: none; margin: 0; padding: 0">
<li style="position: relative; display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 0 0 28px 28px; border-left: 2px solid #D5DCD7; margin-left: 5px">
<span aria-hidden="true" style="position: absolute; left: -7px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: #3F6B57"></span>
<p style="flex: 0 0 130px; margin: 0; font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #3F6B57">En cours</p>
<div style="flex: 1 1 220px; min-width: 0">
<p style="margin: 0; font-weight: 600">IBM System Analyst</p>
<p style="margin: 0; font-size: 15px; color: #5B6160">Formation professionnelle certifiante</p>
<p style="margin: 8px 0 0; font-size: 15px">Dont le TP du tableau de bord ventes et SAV.</p>
</div>
</li>
<li style="position: relative; display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 0 0 28px 28px; border-left: 2px solid #D5DCD7; margin-left: 5px">
<span aria-hidden="true" style="position: absolute; left: -7px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: #3F6B57"></span>
<p style="flex: 0 0 130px; margin: 0; font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #3F6B57">Depuis juin 2026</p>
<div style="flex: 1 1 220px; min-width: 0">
<p style="margin: 0; font-weight: 600">Business Analyst</p>
<p style="margin: 0; font-size: 15px; color: #5B6160">Akieni Academy</p>
<p style="margin: 8px 0 0; font-size: 15px">Formation professionnelle en analyse métier, études de cas en équipe.</p>
</div>
</li>
<li style="position: relative; display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 0 0 4px 28px; border-left: 2px solid transparent; margin-left: 5px">
<span aria-hidden="true" style="position: absolute; left: -7px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: #3F6B57"></span>
<p style="flex: 0 0 130px; margin: 0; font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #3F6B57">2025 à 2028</p>
<div style="flex: 1 1 220px; min-width: 0">
<p style="margin: 0; font-weight: 600">Licence Réseaux et Télécommunications</p>
<p style="margin: 0; font-size: 15px; color: #5B6160">Institut Panafricain Heavens, Brazzaville</p>
<p style="margin: 8px 0 0; font-size: 15px">La base technique qui me permet de dialoguer avec les développeurs.</p>
</div>
</li>
</ol>
</div>

</div>

<section style="padding-bottom: 88px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 32px">
<h2 style="margin: 0; font-weight: 600; font-size: 32px; line-height: 1.15; letter-spacing: -0.02em">Certifications</h2>
<a href="https://www.credly.com/users/laije-belthassar" style="font-size: 15px; text-decoration: none; border-bottom: 1px solid #C9D3CC; padding-bottom: 2px">Vérifier sur Credly</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px">
<Cert title="Business Analyst" issuer="Microsoft" logo="microsoft.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="Data Analytics" issuer="Google" logo="google.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="Business Intelligence" issuer="Google" logo="google.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="Python Development" issuer="Microsoft" logo="microsoft.svg" platform="Coursera" platformLogo="coursera.svg" />
<Cert title="English for IT 1 et 2" issuer="OpenEDG" logo="openedg.svg" note="2026" />
<Cert title="System Analyst" issuer="IBM" logo="ibm.svg" platform="Coursera" platformLogo="coursera.svg" note="En cours" muted={true} />
</div>
</section>

<section style="display: flex; flex-wrap: wrap; gap: 24px 64px; padding-bottom: 104px">
<h2 style="flex: 1 1 240px; margin: 0; font-weight: 600; font-size: 32px; line-height: 1.15; letter-spacing: -0.02em">Langues</h2>
<ul style="flex: 999 1 520px; min-width: 0; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px">
<li style="padding: 10px 18px; border-radius: 999px; background: #FFFFFF; border: 1px solid #E3E5E1">Français</li>
<li style="padding: 10px 18px; border-radius: 999px; background: #FFFFFF; border: 1px solid #E3E5E1">Lingala</li>
<li style="padding: 10px 18px; border-radius: 999px; background: #FFFFFF; border: 1px solid #E3E5E1">Kituba</li>
<li style="padding: 10px 18px; border-radius: 999px; background: #FFFFFF; border: 1px solid #E3E5E1">Anglais technique</li>
</ul>
</section>

</BaseLayout>
