---
interface Props {
  active?: 'projets' | 'parcours' | null;
  current?: boolean;
}
const { active = null, current = false } = Astro.props;
---
<header class="site-header">
<a href="/" class="site-header__brand">Laije Belthassar BALONG</a>
<nav class="site-nav">
<a href="/projets" class:list={["site-nav__link", { "is-active": active === 'projets' }]} aria-current={active === 'projets' && current ? 'page' : undefined}>Projets</a>
<a href="/parcours" class:list={["site-nav__link", { "is-active": active === 'parcours' }]} aria-current={active === 'parcours' && current ? 'page' : undefined}>Parcours</a>
<a href="#contact" class="site-nav__link">Contact</a>
<a href="#" class="btn btn--line btn--sm">CV en PDF</a>
</nav>
</header>

<style>
.site-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 24px 0;
}
.site-header__brand {
  text-decoration: none;
  font-weight: 600;
  font-size: 18px;
  letter-spacing: -0.01em;
}
.site-nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 28px;
  font-size: 15px;
}
.site-nav__link { text-decoration: none; }
.site-nav__link.is-active,
.site-nav__link.is-active:hover { color: var(--color-accent); }
</style>
