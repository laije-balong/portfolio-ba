---
interface Props {
  active?: 'projets' | 'parcours' | null;
  current?: boolean;
}
const { active = null, current = false } = Astro.props;
const projetsStyle = 'text-decoration: none' + (active === 'projets' ? '; color: #3F6B57' : '');
const parcoursStyle = 'text-decoration: none' + (active === 'parcours' ? '; color: #3F6B57' : '');
---
<header style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 0">
<a href="/" style="text-decoration: none; font-weight: 600; font-size: 18px; letter-spacing: -0.01em">Laije Belthassar BALONG</a>
<nav style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; font-size: 15px">
<a href="/projets" aria-current={active === 'projets' && current ? 'page' : undefined} style={projetsStyle}>Projets</a>
<a href="/parcours" aria-current={active === 'parcours' && current ? 'page' : undefined} style={parcoursStyle}>Parcours</a>
<a href="#contact" style="text-decoration: none">Contact</a>
<a href="#" class="btn btn-line" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid #D5D9D4; border-radius: 999px; text-decoration: none; color: #17191A">CV en PDF</a>
</nav>
</header>
