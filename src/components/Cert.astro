---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title: string;
  issuer: string;
  logo: string;
  platform?: string;
  platformLogo?: string;
  note?: string;
  muted?: boolean;
}
const { title, issuer, logo, platform, platformLogo, note, muted = false } = Astro.props;

// Le logo officiel n'est affiché que si le fichier a été déposé dans public/logos.
// Sinon, on retombe proprement sur une pastille texte, sans image cassée.
const logoExists = (file?: string) => !!file && existsSync(join(process.cwd(), 'public', 'logos', file));
const hasIssuerLogo = logoExists(logo);
const hasPlatformLogo = logoExists(platformLogo);
---
<div class:list={["card", "cert", { "cert--muted": muted }]}>
<div class="cert__logos">
{hasIssuerLogo
  ? <img src={`/logos/${logo}`} alt={issuer} class="cert__logo" />
  : <span class="cert__badge cert__badge--issuer">{issuer}</span>
}
{platform && (hasPlatformLogo
  ? <img src={`/logos/${platformLogo}`} alt={platform} class="cert__logo cert__logo--platform" />
  : <span class="cert__badge cert__badge--platform">{platform}</span>
)}
</div>
<div>
<p class="cert__title">{title}</p>
{note && <p class:list={["cert__note", { "cert__note--accent": muted }]}>{note}</p>}
</div>
</div>

<style>
.cert {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 22px;
  border-radius: var(--radius-box);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
}
.cert--muted { background: var(--color-surface-muted); border-color: var(--color-surface-muted); }
.cert__logos {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  min-height: 30px;
}
.cert__logo { display: block; height: 28px; width: auto; max-width: 120px; object-fit: contain; }
.cert__logo--platform { height: 24px; max-width: 110px; }
.cert__badge { display: inline-flex; align-items: center; border-radius: var(--radius-pill); }
.cert__badge--issuer {
  height: 26px;
  padding: 0 12px;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  font-size: 13px;
  font-weight: 500;
}
.cert__badge--platform {
  height: 24px;
  padding: 0 10px;
  background: #F1F2EF;
  color: var(--color-text-muted);
  font-size: 12px;
}
.cert__title { margin: 0; font-weight: 600; }
.cert__note { margin: 6px 0 0; font-family: var(--font-mono); font-size: 12px; color: var(--color-text-subtle); }
.cert__note--accent { color: var(--color-accent); }
</style>
